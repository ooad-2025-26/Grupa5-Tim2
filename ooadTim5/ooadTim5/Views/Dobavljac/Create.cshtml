@model ooadTim5.Models.Dobavljac

@{
    ViewData["Title"] = "Dodaj dobavljača";
}

<div style="padding:40px 60px;">

    <div style="background:white; border-radius:16px; padding:30px;
        box-shadow:0 2px 16px rgba(0,0,0,0.08); max-width:700px;">

        <h2 style="margin-bottom:20px; color:#1a4a3a;">Dodaj dobavljača</h2>

        <form asp-action="Create">

            <input asp-for="Naziv" placeholder="Naziv"
                   style="width:100%; padding:10px; margin-bottom:10px;" />

            <input asp-for="KontaktEmail" placeholder="Email"
                   style="width:100%; padding:10px; margin-bottom:10px;" />

            <input asp-for="KontaktTelefon" placeholder="Telefon"
                   style="width:100%; padding:10px; margin-bottom:10px;" />

            <input asp-for="Adresa" placeholder="Adresa"
                   style="width:100%; padding:10px; margin-bottom:20px;" />

            <button type="submit"
                    style="background:#2e7d32; color:white; padding:10px 20px;
                border:none; border-radius:25px; font-weight:700;">
                Sačuvaj
            </button>

            <a asp-action="Index"
                   style="margin-left:10px; color:#1a4a3a; font-weight:600;">
                Nazad
            </a>

        </form>

    </div>
</div>