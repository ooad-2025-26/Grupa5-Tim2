<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LitHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
            body {
                background-color: #f9f5f0;
                font-family: 'Segoe UI', sans-serif;
            }

            .navbar-lithub {
                background-color: #f9f5f0;
                border-bottom: 1px solid #e0d8cf;
                padding: 15px 30px;
            }

            .navbar-brand-lithub {
                font-size: 1.5rem;
                font-weight: 700;
                color: #1a4a3a !important;
                text-decoration: none;
                margin-right: 30px;
            }

                .navbar-brand-lithub:hover {
                    color: #1a4a3a !important;
                }

            .nav-link-lithub {
                color: #1a4a3a !important;
                font-weight: 600;
                font-size: 0.85rem;
                letter-spacing: 0.05rem;
                text-transform: uppercase;
                margin-right: 20px;
                text-decoration: none;
            }

                .nav-link-lithub:hover {
                    color: #c8621a !important;
                }

            .btn-prijava {
                border: 2px solid #1a4a3a;
                color: #1a4a3a;
                background: transparent;
                border-radius: 25px;
                padding: 6px 20px;
                font-weight: 600;
                font-size: 0.85rem;
                letter-spacing: 0.05rem;
                text-transform: uppercase;
                text-decoration: none;
                margin-right: 10px;
            }

                .btn-prijava:hover {
                    background-color: #1a4a3a;
                    color: white;
                }

            .btn-registracija {
                background-color: #c8621a;
                color: white;
                border: none;
                border-radius: 25px;
                padding: 6px 20px;
                font-weight: 600;
                font-size: 0.85rem;
                letter-spacing: 0.05rem;
                text-transform: uppercase;
                text-decoration: none;
            }

                .btn-registracija:hover {
                    background-color: #a8521a;
                    color: white;
                }

            .btn-odjava {
                border: 2px solid #c8621a;
                color: #c8621a;
                background: transparent;
                border-radius: 25px;
                padding: 6px 20px;
                font-weight: 600;
                font-size: 0.85rem;
                letter-spacing: 0.05rem;
                text-transform: uppercase;
                text-decoration: none;
                margin-right: 10px;
            }

                .btn-odjava:hover {
                    background-color: #c8621a;
                    color: white;
                }

            .main-content {
                min-height: calc(100vh - 140px);
            }

            footer {
                background-color: #1a4a3a;
                color: #ccc;
                padding: 20px 0;
                font-size: 0.85rem;
            }

                footer a {
                    color: #c8621a;
                    text-decoration: none;
                }
    </style>
</head>
<body>

    <!-- NAVIGACIJA -->
    <nav class="navbar navbar-expand-md navbar-lithub">
        <div class="container-fluid px-4">

            <!-- Logo i naziv -->
            <a class="navbar-brand-lithub" asp-controller="Home" asp-action="Index">
                📖 LitHub
            </a>

            <!-- Hamburger za mobilne -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Linkovi -->
            <div class="collapse navbar-collapse" id="navbarContent">

                <!-- Lijeva strana -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link-lithub"
                               asp-controller="Home"
                               asp-action="Index">
                            Početna
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link-lithub"
                               asp-controller="Home"
                               asp-action="ONama">
                            O nama
                        </a>
                    </li>


                    @if (User.IsInRole("clan"))
                    {
                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="ZahtjevZaPosudbu"
                                   asp-action="Index">
                                Zahtjevi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="Korisnici" asp-action="Profil">
                                Profil
                            </a>
                        </li>

                        
                    }

                    @if (User.IsInRole("administrator"))
                    {
                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="ZahtjevZaPosudbu"
                                   asp-action="Index">
                                Zahtjevi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="Knjiga"
                                   asp-action="Index">
                                Knjige
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="Korisnici"
                                   asp-action="Index">
                                Korisnici
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="ClanskeKartice" asp-action="NoviClanovi">
                                Članske kartice
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="Posudba"
                                   asp-action="Index">
                                Posudbe
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="Dobavljac" asp-action="Index">
                                Dobavljači
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="NabavkaKnjiga" asp-action="Index">
                                Nabavka knjiga
                            </a>
                        </li>
                    }


                    @if (User.IsInRole("bibliotekar"))
                    {
                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="ZahtjevZaPosudbu"
                                   asp-action="Index">
                                Zahtjevi
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub"
                                   asp-controller="Knjiga"
                                   asp-action="Index">
                                Knjige
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="ClanskeKartice" asp-action="NoviClanovi">
                                Članske kartice
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-lithub" asp-controller="Posudba"
                                   asp-action="Index">
                                Posudbe
                            </a>
                        </li>
                    }



                        

                </ul>

                <!-- Desna strana -->
                <div class="d-flex align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span style="color: #1a4a3a; font-weight: 600; font-size: 0.85rem; margin-right: 15px;">
                            @User.Identity.Name
                        </span>
                        <a class="btn-odjava"
                           asp-controller="Home"
                           asp-action="Odjava">Odjava</a>
                    }
                    else
                    {
                        <a class="btn-prijava"
                           asp-controller="Home"
                           asp-action="Prijava">Prijava</a>
                        <a class="btn-registracija"
                           asp-controller="Home"
                           asp-action="Registracija">Registracija</a>
                    }
                </div>

            </div>
        </div>
    </nav>

    <!-- GLAVNI SADRŽAJ -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">
                &copy; 2025 LitHub — Sistem za upravljanje bibliotekom |
                <a asp-controller="Home" asp-action="ONama">O nama</a>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>