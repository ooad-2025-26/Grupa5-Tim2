@model ooadTim5.Models.Knjiga

@{
    ViewData["Title"] = "Detalji knjige";
}

<div style="padding: 40px 60px;">
    <div style="background: white; border-radius: 16px; padding: 40px;
                box-shadow: 0 2px 12px rgba(0,0,0,0.06); display: flex; gap: 40px;">
        
        <!-- Lijeva strana - naslovnica -->
        <div style="flex: 0 0 300px;">
            @if (!string.IsNullOrEmpty(Model.Naslovnica))
            {
                <img src="@Model.Naslovnica" 
                     style="width: 100%; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.15);" />
            }
            else
            {
                <div style="width: 100%; height: 400px; background: #f0ebe4; border-radius: 12px;
                            display: flex; align-items: center; justify-content: center;
                            color: #999; font-size: 1rem;">
                    Nema naslovnice
                </div>
            }
        </div>

        <!-- Desna strana - info -->
        <div style="flex: 1;">
            <!-- Status -->
            @if (Model.Status.ToString() == "dostupna")
            {
                <span style="background: #e8f5e9; color: #2e7d32; padding: 6px 16px;
                             border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
                    ● Dostupno u biblioteci
                </span>
            }
            else
            {
                <span style="background: #fce4e4; color: #c62828; padding: 6px 16px;
                             border-radius: 20px; font-size: 0.85rem; font-weight: 600;">
                    ● Nije dostupno
                </span>
            }

            <h1 style="color: #1a4a3a; font-weight: 800; margin-top: 15px; font-size: 2.5rem;">
                @Model.Naziv
            </h1>
            <h3 style="color: #c8621a; font-weight: 600; margin-bottom: 30px;">
                @Model.Autor
            </h3>

            <!-- Detalji -->
            <table style="width: 100%; border-collapse: collapse;">
                <tr style="border-bottom: 1px solid #f0ebe4;">
                    <td style="padding: 12px 0; color: #999; font-size: 0.8rem; 
                               font-weight: 700; text-transform: uppercase; width: 150px;">
                        ISBN
                    </td>
                    <td style="padding: 12px 0; font-weight: 600;">@Model.ISBN</td>
                </tr>
                <tr style="border-bottom: 1px solid #f0ebe4;">
                    <td style="padding: 12px 0; color: #999; font-size: 0.8rem; 
                               font-weight: 700; text-transform: uppercase;">
                        Kategorija
                    </td>
                    <td style="padding: 12px 0; font-weight: 600;">@Model.Kategorija</td>
                </tr>
                <tr style="border-bottom: 1px solid #f0ebe4;">
                    <td style="padding: 12px 0; color: #999; font-size: 0.8rem; 
                               font-weight: 700; text-transform: uppercase;">
                        Izdavač
                    </td>
                    <td style="padding: 12px 0; font-weight: 600;">@Model.Izdavac</td>
                </tr>
                <tr style="border-bottom: 1px solid #f0ebe4;">
                    <td style="padding: 12px 0; color: #999; font-size: 0.8rem; 
                               font-weight: 700; text-transform: uppercase;">
                        Godina
                    </td>
                    <td style="padding: 12px 0; font-weight: 600;">@Model.GodinaIzdanja</td>
                </tr>
                <tr>
                    <td style="padding: 12px 0; color: #999; font-size: 0.8rem; 
                               font-weight: 700; text-transform: uppercase;">
                        Stranica
                    </td>
                    <td style="padding: 12px 0; font-weight: 600;">@Model.BrojStranica str.</td>
                </tr>
            </table>

            <!-- Dugmad -->
            <div style="margin-top: 30px; display: flex; gap: 15px; flex-wrap: wrap;">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    if (Model.Status.ToString() == "dostupna")
                    {
                        <a asp-controller="ZahtjevZaPosudbu" asp-action="Create" asp-route-knjigaId="@Model.Id"
                               style="background-color: #c8621a; color: white; border-radius: 25px;
                            padding: 12px 30px; font-weight: 700; font-size: 0.9rem;
                            text-decoration: none; text-transform: uppercase;">
                            Posudi knjigu
                        </a>
                    }
                }

                @if (User.IsInRole("administrator") || User.IsInRole("bibliotekar"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       style="background-color: #1a4a3a; color: white; border-radius: 25px;
                              padding: 12px 30px; font-weight: 700; font-size: 0.9rem;
                              text-decoration: none; text-transform: uppercase;">
                        Uredi
                    </a>
                }

                <a asp-action="Index"
                   style="border: 2px solid #1a4a3a; color: #1a4a3a; border-radius: 25px;
                          padding: 12px 30px; font-weight: 700; font-size: 0.9rem;
                          text-decoration: none; text-transform: uppercase;">
                    Nazad
                </a>
            </div>
        </div>
    </div>
</div>