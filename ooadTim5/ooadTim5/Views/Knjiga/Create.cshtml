@model ooadTim5.Models.Knjiga

<div style="display:flex; justify-content:center; padding:40px;">

    <div style="
        width:550px;
        background:white;
        border-radius:16px;
        box-shadow:0 6px 20px rgba(0,0,0,0.12);
        padding:30px;
        ">

        <h2 style="
            text-align:center;
            color:#1a4a3a;
            font-weight:800;
            margin-bottom:25px;">
            Dodavanje knjige
        </h2>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <!-- NAZIV -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Naziv</label>
                <input asp-for="Naziv"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
                <span asp-validation-for="Naziv" class="text-danger"></span>
            </div>

            <!-- AUTOR -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Autor</label>
                <input asp-for="Autor"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>

            <!-- ISBN -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">ISBN</label>
                <input asp-for="ISBN"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>

            <!-- KATEGORIJA -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Kategorija</label>
                <input asp-for="Kategorija"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
            </div>

            <!-- GODINA -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Godina izdanja</label>
                <input asp-for="GodinaIzdanja"
                       type="number"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
            </div>

            <!-- STRANICE -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Broj stranica</label>
                <input asp-for="BrojStranica"
                       type="number"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
            </div>

            <!-- IZDAVAČ -->
            <div style="margin-bottom:12px;">
                <label style="font-weight:600;">Izdavač</label>
                <input asp-for="Izdavac"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
            </div>

            <!-- NASLOVNICA -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600;">Naslovnica (URL ili putanja)</label>
                <input asp-for="Naslovnica"
                       class="form-control"
                       style="border-radius:10px; padding:10px;" />
            </div>

            <!-- STATUS -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600;">Status</label>
                <select asp-for="Status"
                        class="form-control"
                        asp-items="Html.GetEnumSelectList<ooadTim5.Models.Enums.StatusKnjige>()"
                        style="border-radius:10px; padding:10px;">
                </select>
            </div>

            <!-- BUTTON -->
            <button type="submit"
                    style="
                width:100%;
                background:#1a4a3a;
                color:white;
                border:none;
                padding:12px;
                border-radius:12px;
                font-weight:700;">
                Sačuvaj knjigu
            </button>

        </form>
    </div>
</div>