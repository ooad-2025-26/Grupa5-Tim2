@model ooadTim5.Models.ZahtjevZaPosudbu

@{
    ViewData["Title"] = "Detalji zahtjeva";
}

<div style="padding: 40px 60px;">

    <div style="background: white; border-radius: 16px; overflow: hidden;
        box-shadow: 0 2px 16px rgba(0,0,0,0.08);">

        <!-- HEADER -->
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: #e8e4f0;">
                    <th style="padding: 16px 24px;">Korisnik</th>
                    <th style="padding: 16px 24px; border-left: 1px solid #ddd;">Knjiga</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <!-- KORISNIK -->
                    <td style="padding: 24px; border-bottom: 1px solid #eee;">
                        <p><strong>Ime:</strong> @ViewBag.KorisnikEmail</p>
                        <p><strong>Datum zahtjeva:</strong> @Model.DatumZahtjeva.ToString("dd.MM.yyyy")</p>
                    </td>

                    <!-- KNJIGA -->
                    <td style="padding: 24px; border-left: 1px solid #eee; border-bottom: 1px solid #eee;">
                        <p><strong>Naslov:</strong> @Model.Knjiga?.Naziv</p>
                        <p><strong>Autor:</strong> @Model.Knjiga?.Autor</p>

                        <p>
                            <strong>Dostupnost:</strong>
                            @if (Model.Knjiga?.Status.ToString() == "dostupna")
                            {
                                <span style="color:green;font-weight:700;">Dostupna</span>
                            }
                            else
                            {
                                <span style="color:red;font-weight:700;">Nedostupna</span>
                            }
                        </p>
                    </td>
                </tr>

                <!-- STATUS -->
                <tr>
                    <td colspan="2" style="padding: 16px 24px;">
                        <strong>Status:</strong>

                        @if (Model.Status.ToString() == "Na_cekanju")
                        {
                            <span style="background:orange;color:white;padding:4px 10px;border-radius:10px;">
                                Na čekanju
                            </span>
                        }
                        else if (Model.Status.ToString() == "odobren")
                        {
                            <span style="background:green;color:white;padding:4px 10px;border-radius:10px;">
                                Odobren
                            </span>
                        }
                        else
                        {
                            <span style="background:red;color:white;padding:4px 10px;border-radius:10px;">
                                Odbijen
                            </span>
                        }

                        @if (!string.IsNullOrEmpty(Model.RazlogOdbijanja))
                        {
                            <span style="margin-left:10px;color:#666;">
                                (@Model.RazlogOdbijanja)
                            </span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- ⚠ POSUDBE -->
        @if (ViewBag.AktivnePosudbe != null &&
                    ((List<ooadTim5.Models.Posudba>)ViewBag.AktivnePosudbe).Any())
        {
            <div style="margin:20px 24px;background:#fff3cd;padding:15px;border-radius:10px;">
                <strong>⚠ Nevraćene knjige:</strong>
                <ul>
                    @foreach (var p in (List<ooadTim5.Models.Posudba>)ViewBag.AktivnePosudbe)
                    {
                        <li>
                            @p.Knjiga?.Naziv
                            (rok: @p.OcekivaniDatumVracanja.ToString("dd.MM.yyyy"))
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- 📌 ČLANSKA KARTICA -->
        <div style="margin:20px 24px;">

            @if (ViewBag.Kartica == null)
            {
                <div style="background:#ffebee;color:#c62828;padding:12px;border-radius:10px;">
                    ❌ Korisnik nema člansku karticu!
                </div>
            }
            else if (!(bool)ViewBag.ValidnaKartica)
            {
                <div style="background:#fff3e0;color:#e65100;padding:12px;border-radius:10px;">
                    ⚠ Kartica nije validna ili je istekla!
                    <br />
                    Vrijedi do: @ViewBag.Kartica.ClanstvoVaziDo.ToString("dd.MM.yyyy")
                </div>
            }
            else
            {
                <div style="background:#e8f5e9;color:#2e7d32;padding:12px;border-radius:10px;">
                    ✅ Članska kartica validna
                </div>
            }
        </div>

        <!-- 🔘 AKCIJE -->
        @if ((User.IsInRole("administrator") || User.IsInRole("bibliotekar"))
                    && Model.Status.ToString() == "Na_cekanju")
        {
            <div style="padding: 20px 24px; display:flex; gap:10px;">

                @if (ViewBag.ValidnaKartica == true)
                {
                    <form asp-action="Odobri" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button style="background:green;color:white;padding:10px 20px;border:none;border-radius:20px;">
                            Odobri
                        </button>
                    </form>
                }
                else
                {
                    <div style="color:red;font-weight:700;align-self:center;">
                        ❌ Odobravanje nije moguće (kartica nevažeća)
                    </div>
                }

                <form asp-action="Odbij" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input name="razlog" placeholder="Razlog..."
                           style="padding:8px;border-radius:10px;border:1px solid #ccc;" />
                    <button style="background:red;color:white;padding:10px 20px;border:none;border-radius:20px;">
                        Odbij
                    </button>
                </form>

            </div>
        }

        <!-- 🔙 BACK -->
        <div style="padding: 16px 24px; border-top:1px solid #eee;">
            <a asp-action="Index" style="color:#1a4a3a;font-weight:600;text-decoration:none;">
                ← Nazad
            </a>
        </div>

    </div>
</div>