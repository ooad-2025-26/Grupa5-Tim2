@model ooadTim5.Models.ZahtjevZaPosudbu

@{
    ViewData["Title"] = "Novi zahtjev";
}

<div style="padding: 40px 60px;">
    <h1 style="color:#1a4a3a; font-weight:800; margin-bottom:30px;">
        Novi zahtjev za posudbu
    </h1>

    <div style="background:white; padding:30px; border-radius:12px;
        box-shadow:0 2px 12px rgba(0,0,0,0.06); width:400px;">

        <form asp-action="Create" method="post">

            @* Knjiga je već odabrana, samo je prikazujemo *@
            <input type="hidden" asp-for="KnjigaId" />

            <div style="margin-bottom:20px;">
                <label style="color:#999; font-size:0.8rem; font-weight:700; text-transform:uppercase;">
                    Knjiga
                </label>
                <p style="font-weight:600; color:#1a4a3a; margin-top:5px;">
                    @(ViewBag.NazivKnjige ?? "Odabrana knjiga")
                </p>
            </div>

            <button type="submit"
                    style="background:#c8621a; color:white; border:none;
                padding:12px 30px; border-radius:25px; font-weight:700;
                font-size:0.9rem; text-transform:uppercase; cursor:pointer;">
                Pošalji zahtjev
            </button>

            <a asp-controller="Knjiga" asp-action="Index"
                   style="display:inline-block; margin-left:10px; border: 2px solid #1a4a3a;
                color:#1a4a3a; border-radius:25px; padding:12px 30px;
                font-weight:700; font-size:0.9rem; text-decoration:none;
                text-transform:uppercase;">
                Odustani
            </a>

        </form>


    </div>
</div>