@model IEnumerable<ooadTim5.Models.ZahtjevZaPosudbu>

@{
    ViewData["Title"] = "Zahtjevi";
}

<div style="padding: 40px 60px;">
    <h1 style="color: #1a4a3a; font-weight: 800; margin-bottom: 30px;">
        Lista zahtjeva:
    </h1>

    <div style="background: white; border-radius: 12px; overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);">

        <table class="table" style="margin: 0;">
            <thead>
                <tr style="background-color: #f0ebe4;">
                    <th style="padding: 15px 20px; color: #1a4a3a; font-weight: 700;">Korisnik</th>
                    <th style="padding: 15px 20px; color: #1a4a3a; font-weight: 700;">Knjiga</th>
                    <th style="padding: 15px 20px; color: #1a4a3a; font-weight: 700;">Datum</th>
                    <th style="padding: 15px 20px; color: #1a4a3a; font-weight: 700;">Status</th>
                    <th style="padding: 15px 20px; color: #1a4a3a; font-weight: 700;">Akcija</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom: 1px solid #f0ebe4;">

                        <td style="padding: 15px 20px; color: #666;">
                            @(((Dictionary<string, string>)ViewBag.Korisnici)
                                .GetValueOrDefault(item.KorisnikId ?? "", item.KorisnikId ?? "-"))
                        </td>

                        <td style="padding: 15px 20px; font-weight: 600; color: #1a4a3a;">
                            @item.Knjiga?.Naziv
                        </td>

                        <td style="padding: 15px 20px; color: #666;">
                            @item.DatumZahtjeva.ToString("dd.MM.yyyy")
                        </td>

                        <!-- ✅ OVO JE ISPRAVLJEN DIO -->
                        <td style="padding: 15px 20px;">
                            @if (item.Status == ooadTim5.Models.Enums.StatusZahtjeva.Na_cekanju)
                            {
                                <span style="background: orange; color: white;
                                    padding: 4px 12px; border-radius: 20px;
                                    font-size: 0.85rem; font-weight: 600;">
                                    Na čekanju
                                </span>
                            }
                            else if (item.Status == ooadTim5.Models.Enums.StatusZahtjeva.odobren)
                            {
                                <span style="background: #2e7d32; color: white;
                                    padding: 4px 12px; border-radius: 20px;
                                    font-size: 0.85rem; font-weight: 600;">
                                    Odobreno
                                </span>
                            }
                            else
                            {
                                <span style="background: #c62828; color: white;
                                    padding: 4px 12px; border-radius: 20px;
                                    font-size: 0.85rem; font-weight: 600;">
                                    Odbijeno
                                </span>
                            }
                        </td>

                        <td style="padding: 15px 20px;">
                            <a asp-action="Details" asp-route-id="@item.Id"
                                   style="background-color: #c8621a; color: white;
                                border-radius: 20px; padding: 6px 16px;
                                font-size: 0.8rem; font-weight: 700;
                                text-decoration: none; text-transform: uppercase;">
                                Detalji
                            </a>

                            @if (User.IsInRole("administrator"))
                            {
                                <form asp-action="Delete" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />

                                    <button type="submit"
                                            onclick="return confirm('Da li želiš obrisati zahtjev?')"
                                            style="
                                        background:#c62828;
                                        color:white;
                                        border:none;
                                        border-radius:20px;
                                        padding:6px 16px;
                                        font-size:0.8rem;
                                        font-weight:700;
                                        text-transform:uppercase;
                                        margin-left:6px;
                                        cursor:pointer;">
                                        Obriši
                                    </button>
                                </form>
                            }
                        </td>

                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>
