@model ooadTim5.Models.NabavkaKnjiga

<div style="padding:40px 60px;">

    <h2>Obriši nabavku</h2>

    <div style="background:white;padding:20px;border-radius:12px;">
        <p>Da li želiš obrisati nabavku za:</p>
        <h4>@Model.NazivKnjige</h4>

        <form asp-action="DeleteConfirmed" method="post">
            <input type="hidden" asp-for="Id" />

            <button style="background:red;color:white;padding:10px 18px;border:none;">
                Obriši
            </button>

            <a asp-action="Index" style="margin-left:10px;">Nazad</a>
        </form>
    </div>
</div>