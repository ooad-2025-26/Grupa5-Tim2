@model ooadTim5.Models.NabavkaKnjiga

@{
    ViewData["Title"] = "Nova nabavka";
}

<div style="padding:40px 60px;">

    <div style="background:white; border-radius:16px; padding:30px;
        box-shadow:0 2px 16px rgba(0,0,0,0.08); max-width:700px;">

        <h2 style="color:#1a4a3a;">Nova nabavka knjiga</h2>

        <form asp-action="Create">

            <input asp-for="NazivKnjige" placeholder="Naziv knjige" class="form-control" />

            <input asp-for="AutorKnjige" placeholder="Autor" class="form-control" />

            <label>Dobavljač</label>
            <select asp-for="DobavljacId" asp-items="ViewBag.DobavljacId"
                    style="width:100%; padding:10px; margin-bottom:10px;"></select>

            <input asp-for="Kolicina" placeholder="Količina"
                   style="width:100%; padding:10px; margin-bottom:10px;" />

            <input asp-for="OcekivaniDatumIsporuke"
                   type="date"
                   style="width:100%; padding:10px; margin-bottom:20px;" />

            <button type="submit"
                    style="background:#2e7d32; color:white; padding:10px 20px;
                border:none; border-radius:25px;">
                Sačuvaj
            </button>

            <a asp-action="Index" style="margin-left:10px;">Nazad</a>

        </form>

    </div>
</div>