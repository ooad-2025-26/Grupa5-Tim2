@model IEnumerable<ooadTim5.Models.NabavkaKnjiga>

@{
    ViewData["Title"] = "Nabavke knjiga";
}

<div style="padding: 40px 60px;">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:30px;">
        <h1 style="color:#1a4a3a; font-weight:800;">
            Nabavke knjiga
        </h1>

        <a asp-action="Create"
               style="background:#2e7d32; color:white; padding:10px 22px;
            border-radius:25px; font-weight:700; text-decoration:none;
            text-transform:uppercase; font-size:0.85rem;">
            + Nova nabavka
        </a>
    </div>

    <div style="background:white; border-radius:16px; overflow:hidden;
        box-shadow:0 2px 16px rgba(0,0,0,0.08);">

        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#e8e4f0;">
                    <th style="padding:16px;">Naziv knjige</th>
                    <th style="padding:16px;">Autor</th>
                    <th style="padding:16px;">Dobavljač</th>
                    <th style="padding:16px;">Datum</th>
                    <th style="padding:16px;">Status</th>
                    <th style="padding:16px;">Akcije</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom:1px solid #eee;">

                        <td style="padding:14px;">
                            @item.NazivKnjige
                        </td>

                        <td style="padding:14px;">
                            @item.AutorKnjige
                        </td>

                        <td style="padding:14px;">
                            @item.Dobavljac?.Naziv
                        </td>

                        <td style="padding:14px;">
                            @item.DatumNarudzbe.ToString("dd.MM.yyyy")
                        </td>

                        <td style="padding:14px;">
                            @item.Status
                        </td>

                        <td style="padding:14px; display:flex; gap:8px;">

                            <a asp-action="Details" asp-route-id="@item.Id"
                                   style="background:#1a4a3a; color:white; padding:6px 14px;
                                border-radius:20px; text-decoration:none; font-size:0.8rem;">
                                Detalji
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                                   style="background:#c62828; color:white; padding:6px 14px;
                                border-radius:20px; text-decoration:none; font-size:0.8rem;">
                                Obriši
                            </a>

                        </td>

                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>