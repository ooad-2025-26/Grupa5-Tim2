@model ooadTim5.Models.NabavkaKnjiga

@{
    ViewData["Title"] = "Uredi nabavku";
}

<div style="padding:40px 60px;">

    <div style="background:white; border-radius:16px; padding:30px;
        box-shadow:0 2px 16px rgba(0,0,0,0.08); max-width:700px;">

        <h2 style="color:#1a4a3a; font-weight:800; margin-bottom:20px;">
            Uredi nabavku knjiga
        </h2>

        <form asp-action="Edit">

            <!-- ID (OBAVEZNO) -->
            <input type="hidden" asp-for="Id" />

            <!-- KNJIGA -->
            <label style="font-weight:600;">Knjiga</label>
            <select asp-for="KnjigaId"
                    asp-items="ViewBag.KnjigaId"
                    style="width:100%; padding:10px; margin-bottom:15px; border-radius:10px;">
            </select>

            <!-- DOBAVLJAČ -->
            <label style="font-weight:600;">Dobavljač</label>
            <select asp-for="DobavljacId"
                    asp-items="ViewBag.DobavljacId"
                    style="width:100%; padding:10px; margin-bottom:15px; border-radius:10px;">
            </select>

            <!-- KOLIČINA -->
            <label style="font-weight:600;">Količina</label>
            <input asp-for="Kolicina"
                   style="width:100%; padding:10px; margin-bottom:15px; border-radius:10px;" />

            <!-- DATUM NARUDŽBE -->
            <label style="font-weight:600;">Datum narudžbe</label>
            <input asp-for="DatumNarudzbe"
                   type="date"
                   style="width:100%; padding:10px; margin-bottom:15px; border-radius:10px;" />

            <!-- OČEKIVANI DATUM -->
            <label style="font-weight:600;">Očekivani datum isporuke</label>
            <input asp-for="OcekivaniDatumIsporuke"
                   type="date"
                   style="width:100%; padding:10px; margin-bottom:20px; border-radius:10px;" />

            <!-- STATUS (bitno da možeš mijenjati) -->
            <label style="font-weight:600;">Status</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<ooadTim5.Models.Enums.StatusNabavke>()"
                    style="width:100%; padding:10px; margin-bottom:20px; border-radius:10px;">
            </select>

            <!-- BUTTONI -->
            <button type="submit"
                    style="background:#1a4a3a; color:white; padding:10px 20px;
                border:none; border-radius:25px; font-weight:700;">
                Sačuvaj izmjene
            </button>

            <a asp-action="Index"
                   style="margin-left:10px; color:#1a4a3a; font-weight:600;">
                Nazad
            </a>

        </form>

    </div>
</div>