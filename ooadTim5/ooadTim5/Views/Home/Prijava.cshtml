@{
    ViewData["Title"] = "Prijava";
}

<div style="display: flex; min-height: 85vh; align-items: center; padding: 0 60px; gap: 40px;">
    <div style="flex: 0 0 40%;">
        <div style="background: white; border-radius: 16px; padding: 40px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">
            <h2 style="text-align: center; color: #1a4a3a; font-weight: 700; margin-bottom: 30px;">Prijava</h2>

            @if (ViewBag.Greska != null)
            {
                <div style="background: #ffe0e0; color: #c00; padding: 10px; border-radius: 8px; margin-bottom: 15px;">
                    @ViewBag.Greska
                </div>
            }

            <form method="post" asp-action="Prijava" asp-controller="Home">
                <div style="margin-bottom: 15px;">
                    <input type="email" name="email" placeholder="Email"
                           style="width: 100%; padding: 12px 16px; border: 1px solid #ddd;
                    border-radius: 8px; font-size: 1rem; box-sizing: border-box;" required />
                </div>
                <div style="margin-bottom: 20px;">
                    <input type="password" name="lozinka" placeholder="Lozinka"
                           style="width: 100%; padding: 12px 16px; border: 1px solid #ddd;
                    border-radius: 8px; font-size: 1rem; box-sizing: border-box;" required />
                </div>
                <button type="submit"
                        style="width: 100%; background-color: #c8621a; color: white;
                    border: none; border-radius: 25px; padding: 14px;
                    font-weight: 700; font-size: 1rem; cursor: pointer;">
                    Prijavi se
                </button>
            </form>
        </div>
    </div>

    <div style="flex: 0 0 60%; height: 85vh; overflow: hidden; margin-right: -60px;">
        <img src="~/images/pocetna.jpg"
             style="width: 100%; height: 100%; object-fit: cover; object-position: left center;" />
    </div>
</div>