@model IEnumerable<ooadTim5.Models.ClanskaKartica>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    @if (User.IsInRole("administrator") || User.IsInRole("bibliotekar"))
    {
        <a asp-action="Create">Create New</a>
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.BrojKartice)</th>
            <th>@Html.DisplayNameFor(model => model.DatumIzdavanja)</th>
            <th>@Html.DisplayNameFor(model => model.ClanstvoVaziDo)</th>
            <th>@Html.DisplayNameFor(model => model.Aktivan)</th>
            <th>@Html.DisplayNameFor(model => model.KorisnikId)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.BrojKartice)</td>
                <td>@Html.DisplayFor(modelItem => item.DatumIzdavanja)</td>
                <td>@Html.DisplayFor(modelItem => item.ClanstvoVaziDo)</td>
                <td>@Html.DisplayFor(modelItem => item.Aktivan)</td>
                <td>@Html.DisplayFor(modelItem => item.KorisnikId)</td>
                <td>
                    @if (User.IsInRole("administrator") || User.IsInRole("bibliotekar"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <text> | </text>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (User.IsInRole("administrator"))
                    {
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>