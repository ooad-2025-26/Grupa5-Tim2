@model List<Microsoft.AspNetCore.Identity.IdentityUser>

<div style="padding: 40px 60px;">

    <h2 style="color:#1a4a3a; font-weight:800; margin-bottom:25px;">
        Novi članovi (bez članske kartice)
    </h2>

    <div style="background:white; border-radius:12px;
        box-shadow:0 2px 12px rgba(0,0,0,0.08);
        overflow:hidden;">

        <table class="table" style="margin:0;">
            <thead>
                <tr style="background:#f0ebe4;">
                    <th style="padding:15px;">Email</th>
                    <th style="padding:15px;">Username</th>
                    <th style="padding:15px;">Akcija</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr style="border-bottom:1px solid #f0ebe4;">
                        <td style="padding:15px;">@user.Email</td>
                        <td style="padding:15px;">@user.UserName</td>

                        <td style="padding:15px;">
                            <a asp-action="Create"
                                   asp-route-korisnikId="@user.Id"
                                   style="
                                background:#1a4a3a;
                                color:white;
                                padding:6px 14px;
                                border-radius:20px;
                                text-decoration:none;
                                font-size:0.85rem;
                                font-weight:600;">
                                Kreiraj karticu
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>