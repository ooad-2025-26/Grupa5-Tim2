@model ooadTim5.Models.ClanskaKartica

<div style="display:flex; justify-content:center; padding:40px;">
    <div style="
        width:450px;
        background:white;
        border-radius:16px;
        box-shadow:0 6px 20px rgba(0,0,0,0.12);
        padding:30px;">

        <h2 style="text-align:center; color:#1a4a3a; font-weight:800; margin-bottom:25px;">
            Kreiranje članske kartice
        </h2>

        <form asp-action="Create" method="post">

            <input type="hidden" asp-for="KorisnikId" />

            <!-- DATUM IZDAVANJA -->
            <div style="margin-bottom:15px;">
                <label style="font-weight:600; color:#333;">Datum izdavanja</label>
                <input asp-for="DatumIzdavanja" type="hidden" />
                <input type="text" id="prikaz_izdavanja" readonly
                       class="form-control"
                       style="border-radius:10px; padding:10px; background:#f5f5f5;" />
            </div>

            <!-- VRIJEDI DO -->
            <div style="margin-bottom:15px;">
                <label style="font-weight:600; color:#333;">Članstvo važi do</label>
                <input asp-for="ClanstvoVaziDo" type="hidden" />
                <input type="text" id="prikaz_vazenja" readonly
                       class="form-control"
                       style="border-radius:10px; padding:10px; background:#f5f5f5;" />
            </div>

            <!-- AKTIVAN -->
            <div style="margin-bottom:20px;">
                <label style="font-weight:600; color:#333;">
                    <input asp-for="Aktivan" />
                    Aktivna kartica
                </label>
            </div>

            <!-- BUTTON -->
            <button type="submit" style="
                width:100%;
                background:#1a4a3a;
                color:white;
                border:none;
                padding:12px;
                border-radius:12px;
                font-weight:700;
                transition:0.2s;">
                Sačuvaj karticu
            </button>

        </form>
    </div>
</div>  ← ovdje se završava flex div

<script>
    const mjeseci = [
        "januar", "februar", "mart", "april", "maj", "juni",
        "juli", "august", "septembar", "oktobar", "novembar", "decembar"
    ];

    function popuniDatum(inputName, prikazId) {
        const hidden = document.querySelector(`input[name="${inputName}"]`);
        if (!hidden || !hidden.value) return;

        const d = new Date(hidden.value); // parsira bilo koji format
        const dan = d.getDate();
        const mjesec = mjeseci[d.getMonth()];
        const godina = d.getFullYear();

        document.getElementById(prikazId).value = `${dan}. ${mjesec} ${godina}.`;
    }

    popuniDatum("DatumIzdavanja", "prikaz_izdavanja");
    popuniDatum("ClanstvoVaziDo", "prikaz_vazenja");
</script>