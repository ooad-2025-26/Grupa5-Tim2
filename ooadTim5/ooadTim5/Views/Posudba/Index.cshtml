@model IEnumerable<ooadTim5.Models.Posudba>

<div style="padding:40px 60px;">

    <h2 style="color:#1a4a3a; font-weight:800; margin-bottom:25px;">
        Aktivne posudbe
    </h2>

    <div style="background:white; border-radius:14px; overflow:hidden;
        box-shadow:0 2px 14px rgba(0,0,0,0.08);">

        <table style="width:100%; border-collapse:collapse;">
            <thead style="background:#f0ebe4;">
                <tr>
                    <th style="padding:15px;">Knjiga</th>
                    <th style="padding:15px;">Član</th>
                    <th style="padding:15px;">Datum posudbe</th>
                    <th style="padding:15px;">Rok vraćanja</th>
                    <th style="padding:15px;">Status</th>
                    <th style="padding:15px;">Akcija</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr style="border-bottom:1px solid #eee;">
                        <td style="padding:15px;">
                            @item.Knjiga?.Naziv
                        </td>

                        <td style="padding:15px;">
                            @(((Dictionary<string, string>)ViewBag.Korisnici)
    .GetValueOrDefault(item.ClanId ?? "", "Nepoznat korisnik"))
                        </td>

                        <td style="padding:15px;">
                            @item.DatumPosudbe.ToString("dd.MM.yyyy")
                        </td>

                        <td style="padding:15px;">
                            @item.OcekivaniDatumVracanja.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @if (item.Status == ooadTim5.Models.Enums.StatusPosudbe.aktivna)
                            {
                                <span style="background:#1976d2;color:white;padding:5px 10px;border-radius:15px;">
                                    Aktivna
                                </span>
                            }
                            else if (item.Status == ooadTim5.Models.Enums.StatusPosudbe.vracena)
                            {
                                <span style="background:#2e7d32;color:white;padding:5px 10px;border-radius:15px;">
                                    Vraćena
                                </span>
                            }
                            else
                            {
                                <span style="background:#d32f2f;color:white;padding:5px 10px;border-radius:15px;">
                                    Kašnjenje
                                </span>
                            }
                        </td>

                        <td style="padding:15px;">
                            <a asp-action="Details" asp-route-id="@item.Id"
                                   style="background:#1a4a3a;
                                color:white;
                                padding:6px 14px;
                                border-radius:20px;
                                text-decoration:none;
                                font-weight:600;
                                font-size:0.85rem;
                                margin-right:8px;
                                display:inline-block;">
                                Detalji
                            </a>

                            @if (item.Status == ooadTim5.Models.Enums.StatusPosudbe.aktivna)
                            {
                                <form asp-action="Vrati" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button style="background:#1a4a3a;color:white;
                                        border:none;padding:6px 12px;
                                        border-radius:20px;">
                                        Vrati
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>