@model ooadTim5.Models.Posudba

<div style="padding:40px 60px;">

    <div style="background:white;border-radius:14px;
        padding:25px; box-shadow:0 2px 12px rgba(0,0,0,0.08);">

        <h3 style="color:#1a4a3a;">Detalji posudbe</h3>

        <p><b>Knjiga:</b> @Model.Knjiga?.Naziv</p>
        <strong>Član:</strong> @ViewBag.ClanIme
        <p><b>Datum posudbe:</b> @Model.DatumPosudbe.ToString("dd.MM.yyyy")</p>
        <p><b>Rok vraćanja:</b> @Model.OcekivaniDatumVracanja.ToString("dd.MM.yyyy")</p>

        <p><b>Status:</b> @Model.Status</p>

        @if (Model.DatumVracanja != null)
        {
            <p><b>Datum vraćanja:</b> @Model.DatumVracanja?.ToString("dd.MM.yyyy")</p>
        }

        <div style="margin-top:20px;">
            <a asp-action="Index"
                   style="
                background:#1a4a3a;
                color:white;
                padding:8px 18px;
                border-radius:20px;
                text-decoration:none;
                font-weight:600;
                display:inline-block;">
                ← Nazad na listu
            </a>
        </div>
    </div>
</div>